    "# ============================================================\n",
    "# 10. NETWORK BREADTH VS MARKET DEPTH\n",
    "# ============================================================\n",
    "\n",
    "country_counts = (\n",
    "    qatar.groupby(\"destination_country\")\n",
    "    [\"destination_iata\"]\n",
    "    .nunique()\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "total_countries = len(country_counts)\n",
    "total_destinations = country_counts.sum()\n",
    "\n",
    "countries_single_destination = (\n",
    "    (country_counts == 1).sum()\n",
    ")\n",
    "\n",
    "countries_multi_destination = (\n",
    "    (country_counts >= 2).sum()\n",
    ")\n",
    "\n",
    "countries_3plus = (\n",
    "    (country_counts >= 3).sum()\n",
    ")\n",
    "\n",
    "top_5_destinations = (\n",
    "    country_counts.head(5).sum()\n",
    ")\n",
    "\n",
    "top_5_share = (\n",
    "    top_5_destinations / total_destinations * 100\n",
    ")\n",
    "\n",
    "print(\"🌍 NETWORK BREADTH VS MARKET DEPTH\")\n",
    "print(\"=\" * 65)\n",
    "\n",
    "print(f\"Total countries              : {total_countries}\")\n",
    "print(f\"Countries with 1 destination : {countries_single_destination}\")\n",
    "print(f\"Countries with 2+ destinations: {countries_multi_destination}\")\n",
    "print(f\"Countries with 3+ destinations: {countries_3plus}\")\n",
    "print(f\"Top 5 countries destinations : {top_5_destinations}\")\n",
    "print(f\"Top 5 network share          : {top_5_share:.1f}%\")"
   ]
