    "# ============================================================\n",
    "# 6. ROUTE DISTANCE STRATEGY\n",
    "# ============================================================\n",
    "\n",
    "route_mix = (\n",
    "    qatar.groupby(\"route_type\")\n",
    "    .agg(\n",
    "        Routes=(\"route_id\", \"nunique\"),\n",
    "        Avg_Distance_km=(\"distance_km\", \"mean\"),\n",
    "        Max_Distance_km=(\"distance_km\", \"max\"),\n",
    "        Min_Distance_km=(\"distance_km\", \"min\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "route_mix[\"Network_Share_%\"] = (\n",
    "    route_mix[\"Routes\"]\n",
    "    / route_mix[\"Routes\"].sum()\n",
    "    * 100\n",
    ").round(1)\n",
    "\n",
    "route_mix = route_mix.sort_values(\n",
    "    \"Avg_Distance_km\",\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "route_mix"
   ]
